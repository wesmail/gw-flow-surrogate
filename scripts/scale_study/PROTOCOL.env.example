# =============================================================================
# Scale-study frozen protocol — copy to PROTOCOL.env and edit once.
#   cp scripts/scale_study/PROTOCOL.env.example scripts/scale_study/PROTOCOL.env
# Every generate / train / eval script sources PROTOCOL.env.
# =============================================================================

# --- Paths -------------------------------------------------------------------
# Repo root is auto-detected by common.sh; override only if needed.
# ROOT=/path/to/gw-flow-surrogate

# Python interpreter (cluster: point at your pytorch env)
PYTHON="${PYTHON:-python}"

# Data directory for the single 300k pool (HDF5 + manifests + frozen norms)
DATA_DIR="${DATA_DIR:-data/scale300k}"

# Where CSVs, predictions, figures land
RESULTS_DIR="${RESULTS_DIR:-results/scale_study}"

# TensorBoard / Lightning log root (configs already use logs/scale_study)
LOG_DIR="${LOG_DIR:-logs/scale_study}"

# --- Generation (step 1) -----------------------------------------------------
N_TRAIN_POOL=300000
N_TEST=1000
N_OOD=500
VAL_FRACTION=0.1
SEED=42
DT=0.5
Q_MIN=1.0
Q_MAX=8.0
CHI_MIN=-0.8
CHI_MAX=0.8
# Nested training prefixes carved from the pool
TRAIN_SIZES="6000 12000 25000 50000 120000 300000"

# --- Training rules (step 2) -------------------------------------------------
# residual_scale is filled by 02_freeze_and_slice.py into frozen.json;
# train scripts read it from there. Do not hard-code it here.
EARLY_STOP_PATIENCE=25
MAX_EPOCHS=500

# --- Evaluation protocol (identical for every run) ---------------------------
EVAL_SPLIT=test
CONTEXT_FRACTION=0.5
N_WAVEFORMS=500
N_SAMPLES=1
MEAN_OF=4
N_STEPS=20
MISMATCH_COL=mismatch_phase_time_future
TARGET_MISMATCH=1.0e-4

# --- SLURM defaults (edit for your cluster) ----------------------------------
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"          # e.g. myproject
SLURM_PARTITION_CPU="${SLURM_PARTITION_CPU:-cpu}"
SLURM_PARTITION_GPU="${SLURM_PARTITION_GPU:-gpu}"
SLURM_GPU_GRES="${SLURM_GPU_GRES:-gpu:1}"
SLURM_TIME_GENERATE="${SLURM_TIME_GENERATE:-24:00:00}"
SLURM_TIME_TRAIN="${SLURM_TIME_TRAIN:-48:00:00}"
SLURM_TIME_EVAL="${SLURM_TIME_EVAL:-04:00:00}"
SLURM_CPUS_GENERATE="${SLURM_CPUS_GENERATE:-8}"
SLURM_CPUS_TRAIN="${SLURM_CPUS_TRAIN:-8}"
SLURM_MEM_GENERATE="${SLURM_MEM_GENERATE:-32G}"
SLURM_MEM_TRAIN="${SLURM_MEM_TRAIN:-64G}"
SLURM_MAIL_USER="${SLURM_MAIL_USER:-}"      # optional
